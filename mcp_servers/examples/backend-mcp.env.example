# Merge these values into backend/.env or the environment used by config/launch.py.
# MCP Server processes must use the exact same database and service token.
CAMPUS_MCP_TOKEN=CHANGE_ME_GENERATE_NEW_SERVICE_TOKEN
CAMPUS_MCP_SERVERS={"query_classrooms":"http://127.0.0.1:8100/mcp","query_courses":"http://127.0.0.1:8100/mcp","search_knowledge":"http://127.0.0.1:8100/mcp","query_secondhand":"http://127.0.0.1:8100/mcp","recommend_dishes":"http://127.0.0.1:8101/mcp"}
CAMPUS_TOOL_TIMEOUT=15
