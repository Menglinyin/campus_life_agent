{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Campus load report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "status",
    "created_at",
    "metadata",
    "measurement_seconds",
    "metrics",
    "http_status_counts",
    "observed_response_modes",
    "latency_samples_retained",
    "latency_samples_dropped",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "load"
    },
    "status": {
      "enum": [
        "not_run",
        "completed",
        "no_samples"
      ]
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "metadata": {
      "type": "object"
    },
    "measurement_seconds": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requests_total",
        "requests_successful",
        "requests_failed",
        "success_rate",
        "completed_chat_rps",
        "e2e_p50_ms",
        "e2e_p95_ms",
        "e2e_p99_ms",
        "gpu_0_peak_gib",
        "gpu_1_peak_gib",
        "ttft_p95_ms",
        "model_queue_peak"
      ],
      "properties": {
        "requests_total": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "requests_successful": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "requests_failed": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "success_rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "completed_chat_rps": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "e2e_p50_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "e2e_p95_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "e2e_p99_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "gpu_0_peak_gib": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "gpu_1_peak_gib": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "ttft_p95_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "model_queue_peak": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "http_status_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "observed_response_modes": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "latency_samples_retained": {
      "type": "integer",
      "minimum": 0
    },
    "latency_samples_dropped": {
      "type": "integer",
      "minimum": 0
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
