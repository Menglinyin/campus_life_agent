# These variables are read by the independent voice processes (not CAMPUS_ backend settings).
VOICE_ASR_MODEL_DIR=/absolute/path/to/models/paraformer
VOICE_ASR_VAD_DIR=/absolute/path/to/models/fsmn-vad
VOICE_ASR_PUNC_DIR=/absolute/path/to/models/ct-punc
VOICE_ASR_DEVICE=cpu
VOICE_COSYVOICE_SOURCE=/absolute/path/to/CosyVoice
VOICE_TTS_MODEL_DIR=/absolute/path/to/models/CosyVoice-300M-SFT
VOICE_TTS_FP16=false
VOICE_MAX_CONCURRENCY=1
# Optional: full source commit from git -C /path/to/CosyVoice rev-parse HEAD.
# VOICE_COSYVOICE_COMMIT=...
# Backend process settings for running everything directly on the same machine:
CAMPUS_ASR_URL=http://127.0.0.1:8200/asr
CAMPUS_TTS_URL=http://127.0.0.1:8300/tts
